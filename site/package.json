{
  "name": "site",
  "private": true,
  "description": "The onsystem website. Its data is generated from the library, the demo design system and the benchmark at build time.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs && next dev --port 3300",
    "build": "node scripts/generate.mjs && next build",
    "start": "next start --port 3300",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.91",
    "@radix-ui/react-dialog": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.137",
    "cmdk": "^1.1.1",
    "geist": "^1.7.2",
    "next": "^16.4.2",
    "ondocs": "^0.18.0",
    "onsystem": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
